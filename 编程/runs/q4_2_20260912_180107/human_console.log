PS D:\Users\LENOVO\Desktop\数学建模\国赛团队共享工作区\编程> function Test-Q4NumericTrack {
    param([Parameter(Mandatory=$true)][string]$Track)

    $trackRoot = Join-Path $q4Root $Track
    $manifest = Get-Content -LiteralPath (Join-Path $trackRoot 'run_manifest.json') -Raw -Encoding UTF8 | ConvertFrom-Json
    $assertions = Get-Content -LiteralPath (Join-Path $trackRoot 'assertions.json') -Raw -Encoding UTF8 | ConvertFrom-Json
    $export = Get-Content -LiteralPath (Join-Path $trackRoot 'export_validation.json') -Raw -Encoding UTF8 | ConvertFrom-Json

    $result = [pscustomobject]@{
        track             = $Track
        status            = $manifest.status
        formal_days       = $manifest.formal_days
        initial_soc_feb1  = $manifest.initial_soc_feb1
        assertions_passed = $assertions.passed
        export_passed     = $export.passed
        template_hash     = $manifest.input_sha256.official_result4_2
        finished_at       = $manifest.finished_at
    }

    $result | Format-List

    if ($manifest.formal_days -ne 334) { throw "$Track formal_days 异常" }
    if ([double]$manifest.initial_soc_feb1 -ne 1200.0) { throw "$Track Feb1 SOC 异常" }
    if (-not $assertions.passed) { throw "$Track assertions 失败" }
    if (-not $export.passed) { throw "$Track export validation 失败" }
    if (-not $manifest.finished_at) { throw "$Track manifest 未完成" }

    return $result
}
